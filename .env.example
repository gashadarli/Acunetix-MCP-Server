# Required Acunetix settings
ACUNETIX_BASE_URL=https://10.0.244.136/
ACUNETIX_API_KEY=replace-with-your-api-key

# Most internal Acunetix installs use a private/self-signed certificate.
ACUNETIX_VERIFY_SSL=false

# Safe defaults. Set ACUNETIX_READ_ONLY=false only when you intend to allow
# create_target, start_scan, stop_scan, or generate_report.
ACUNETIX_READ_ONLY=true
ACUNETIX_REQUIRE_CONFIRMATION=true

# Optional comma-separated target UUIDs, hostnames, URLs, or wildcard patterns.
ACUNETIX_TARGET_ALLOWLIST=

# Runtime settings
ACUNETIX_TIMEOUT_SECONDS=30
ACUNETIX_MAX_CONCURRENT_SCAN_STARTS=1
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080
LOG_LEVEL=INFO
